# llm-court backend の設定(すべて任意。未設定なら既定値)
# LLM_COURT_MODELS_CONFIG_PATH=config/models.yaml
# LLM_COURT_SEARXNG_URL=http://localhost:8080
# LLM_COURT_LOG_LEVEL=INFO
# 手元だけでモデル割り当てを変える場合は git 管理外の config/models.local.yaml を作って指定する
# LLM_COURT_MODELS_CONFIG_PATH=config/models.local.yaml

# 捜査パイプライン(research)の設定。ネストした項目は "__" でつなぐ
# researcher に渡すページ本文の最大文字数(モデルのコンテキスト長に合わせる。8k なら 3500 程度)
# LLM_COURT_RESEARCH__MAX_CHARS_PER_PAGE=6000
# LLM_COURT_RESEARCH__TARGET_EVIDENCE=8
# LLM_COURT_RESEARCH__MAX_PAGES=14
